# ==========================================
# BEN Configuration Template (.env.example)
# ==========================================

# Anthropic Claude API Credentials
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom Base URL (leave empty for official Anthropic API)
# ANTHROPIC_BASE_URL=http://127.0.0.1:31415

# Anthropic Claude Model Identifier
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# System Prompt / Agent Identity
BEN_SYSTEM_INSTRUCTION="You are BEN, a personal AI agent assisting with productivity, programming, studying, project management, and computer automation. You are precise, proactive, helpful, and concise."

# Environment & Security
BEN_ENV=development
BEN_HOST=127.0.0.1
BEN_PORT=8000
