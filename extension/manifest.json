{
  "manifest_version": 3,
  "name": "BEN — Personal AI Agent",
  "short_name": "BEN",
  "version": "0.5.0",
  "description": "Your personal AI assistant. Chat, summarize pages, explain selections, and save notes — all powered by your local BEN backend.",

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],

  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "BEN — Personal AI Agent",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
